{
  "name": "ingrid",
  "private": true,
  "description": "Ingrid design system. Figma variables are the source of truth for every token.",
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "tokens": "node packages/tokens/scripts/build.mjs",
    "tokens:check": "node packages/tokens/scripts/build.mjs && git diff --exit-code -- packages/tokens/dist",
    "plugin": "node tools/figma-token-export/build.mjs",
    "plugin:check": "node tools/figma-token-export/build.mjs --check",
    "lint:css": "node scripts/check-css-tokens.mjs",
    "typecheck": "tsc -p packages/react --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.6.0",
    "@storybook/react-vite": "^8.6.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "playwright": "^1.48.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "storybook": "^8.6.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
